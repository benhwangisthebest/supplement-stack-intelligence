# Supabase (Design §10.3) — wired in module-3
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=

# Omniroute — the LLM gateway for the v6 ai-advisor tool-calling adapter
# (Design §9.4), since Phase 2 U25. Server-only. BOTH are required for the live
# advisor: a key with no base URL has nowhere to go, and a base URL with no key
# cannot authenticate, so a missing either answers 503 NOT_CONFIGURED.
# ALL unit tests run without them (the client is injectable; nothing calls out).
#
# There is deliberately NO default base URL. Omniroute's own default is a local
# developer gateway (http://localhost:20128); a deployed application quietly
# inheriting that would fail in a way no operator could read.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=

# REQUIRED, and deliberately with NO default (finding N-21). The routed model
# id, in the GATEWAY INSTANCE's namespace — not Anthropic's, and not portable
# between gateways. This shipped as an optional override defaulting to
# `claude-haiku-4-5`; the first live probe found that bare id does not exist on
# the owner's gateway, whose Haiku ids are provider-namespaced
# (`cc/claude-haiku-4-5-20251001`, `claude/claude-haiku-4-5-20251001`). A
# default here is a claim about a system this code has never contacted, so a
# missing value now answers 503 NOT_CONFIGURED like the two settings above,
# instead of a 400 from the gateway on every single turn.
#
# Pick an id from YOUR gateway's /v1/models. It must report `tool_calling: true`
# — the advisor is a tool loop, and an id without tool calling cannot ground an
# answer, which is a §2.2 rule 7 failure rather than a degraded experience.
OMNIROUTE_MODEL=
# Optional. Per-request wall clock in ms; defaults to 60000, matching the ceiling
# the Anthropic SDK's `timeout` option used to carry.
OMNIROUTE_TIMEOUT_MS=

# Anthropic — lab-timeline PDF extraction adapter (Design §7). Server-only.
# Required only for the live PDF path; CSV/paste import and ALL unit tests work
# without it (the SDK is lazy-imported and injectable).
#
# STILL IN USE, and scheduled to go. Phase 2 U25 moved the ADVISOR to Omniroute;
# the lab-import half is blocked on decision 7B, because an OpenAI-compatible
# endpoint has no equivalent of Anthropic's native PDF `document` block and only
# a live probe can settle what replaces it. This variable — and the
# `@anthropic-ai/sdk` dependency — leave together when that half lands.
API_ANTHROPIC_KEY=

# ai-advisor (v6) — per-user daily token budget (input+output). Optional; defaults
# to 200000 when unset. Caps live LLM spend per user (Design §3.3, Plan SC-8).
ADVISOR_DAILY_TOKEN_BUDGET=
