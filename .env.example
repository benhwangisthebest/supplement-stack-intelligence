# Supabase (Design §10.3) — wired in module-3
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — the LLM provider for the v6 ai-advisor tool-calling adapter
# (Design §9.4) and for lab-import PDF extraction (Design §7), since Phase 2 U31.
# Server-only. There is no second provider and no second key.
#
# HISTORY, kept because it explains the shape below (CLAUDE.md §7): these were
# `ANTHROPIC_*` until U25, `OMNIROUTE_*` from U25 to U31. The wire protocol has
# not changed since U25 — it was OpenAI-compatible from the start — so U31 moved
# settings, not message shapes.
#
# ALL unit tests run with NONE of these set (the client is injectable; nothing
# calls out). CSV/paste lab import also works with nothing configured. What
# stops working unconfigured is the live advisor and PDF extraction, which
# answer 503 AI_SERVICE_NOT_CONFIGURED — deliberately, rather than failing
# obscurely against a half-configured provider.

# REQUIRED. No default in `src/`, and that is a decision rather than an
# oversight: the repository writes no provider-specific address into source
# (CLAUDE.md §2.2 rule 7). For OpenAI's first-party API this is:
#     OPENAI_BASE_URL=https://api.openai.com
# The client appends `/v1/chat/completions` itself and tolerates a trailing
# slash.
#
# [2026-09-18, U32] THIS IS NOW ENFORCED, NOT JUST DOCUMENTED (finding N-63).
# Any other host — and any scheme other than https, any non-default port, any
# userinfo — is REFUSED: both paid routes answer 503 AI_SERVICE_NOT_CONFIGURED
# rather than dialling it. To point at a proxy or a compatible gateway, set the
# override below. It is not a security boundary (whoever can set this line can
# set that one); it makes the choice explicit and logged instead of silent.
OPENAI_BASE_URL=

# OPTIONAL, and empty is the safe state. Set to `1` to permit a non-first-party
# OPENAI_BASE_URL. The client then logs ONCE PER SERVER PROCESS, naming the host
# it is sending to, so an override is visible in the logs of any deployment
# running one. Health context can leave the process to that host (§2.3 rule 15).
OPENAI_ALLOW_NON_FIRST_PARTY_BASE_URL=

# REQUIRED. Server-only; never exposed to the client. Exactly three modules read
# it, pinned by SOLE_PAID_CLIENT in boundaries.test.ts — a fourth reader is a red
# build, because every reader is a place that can authenticate a paid call.
OPENAI_API_KEY=

# REQUIRED, and deliberately with NO default (finding N-21). The model id, in
# YOUR account's namespace. This once shipped as an optional override defaulting
# to `claude-haiku-4-5`; the first live probe found that bare id did not exist on
# the gateway it was pointed at, and EVERY turn would have 400'd with a fully
# green test suite — because a scripted mock accepts whatever id it is handed.
#
# The general rule, which outlived both providers that taught it: a model id is
# a property of the ACCOUNT, not of the protocol. A default here is a claim
# about a system this code has never contacted, so a missing value answers 503
# NOT_CONFIGURED instead of a 400 on every single call.
#
# Take the value verbatim from your account's GET /v1/models. It must support
# tool calling — the advisor is a tool loop, and a model without it cannot
# ground an answer, which is a §2.2 rule 7 failure rather than a degraded
# experience.
OPENAI_MODEL=

# OPTIONAL, no default, omitted from the request body entirely when unset.
# Passed straight through as `reasoning_effort`. The repository validates
# nothing about it: which values your model accepts is your account's fact, not
# this code's (decision 9B).
#
# THE COST OF LEAVING IT BLANK IS STATED HERE BECAUSE NOTHING ELSE WILL SAY IT:
# unset means the model's OWN default effort, which on a reasoning model can be
# substantially more expensive per turn than a low or disabled setting. This is
# a deployment decision, not something a code default should quietly make.
OPENAI_REASONING_EFFORT=

# Optional. Per-request wall clock in ms; defaults to 60000.
OPENAI_TIMEOUT_MS=

# ai-advisor (v6) — per-user daily token budget (input+output). Optional; defaults
# to 200000 when unset. Caps live LLM spend per user (Design §3.3, Plan SC-8).
ADVISOR_DAILY_TOKEN_BUDGET=
