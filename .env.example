# Supabase (Design §10.3) — wired in module-3
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — lab-timeline PDF extraction adapter (Design §7). Server-only.
# Required only for live PDF transcription; CSV/paste import and all unit tests
# work without it. SDK (@anthropic-ai/sdk) is installed when the extract route
# is wired (module-2).
API_ANTHROPIC_KEY=
