# Supabase (Design §10.3) — wired in module-3
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — lab-timeline PDF extraction adapter (Design §7) AND the v6 ai-advisor
# tool-calling adapter (Design §9.4). Server-only. Required only for the live LLM
# paths; CSV/paste import and ALL unit tests work without it (the SDK is lazy-imported
# and injectable). Shared by both features.
API_ANTHROPIC_KEY=

# ai-advisor (v6) — per-user daily token budget (input+output). Optional; defaults
# to 200000 when unset. Caps live LLM spend per user (Design §3.3, Plan SC-8).
ADVISOR_DAILY_TOKEN_BUDGET=
