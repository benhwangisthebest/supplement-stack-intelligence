{
  "version": 1,
  "purpose": "Append-only ledger of reference-data IDs that are PERSISTED in user rows with no foreign key (CLAUDE.md 2.16). Renaming or deleting an entry here silently orphans user data, so removal requires a tombstone with a migration note. This file is the INDEPENDENT baseline: id-stability.test.ts reads it from disk and never regenerates it from the seed arrays it checks.",
  "policy": {
    "add": "New seed ID -> append to the namespace's `ids`. Always allowed; the test fails until it is registered.",
    "remove": "Move the ID from `ids` into `tombstones` with a `migration` note. The test fails while an ID is simply deleted.",
    "rename": "NOT a delete plus an add. Tombstone the old ID with `supersededBy` set to the new ID, and append the new ID to `ids`.",
    "merge": "Tombstone every retired ID with `supersededBy` pointing at the surviving ID.",
    "split": "Tombstone the original with `supersededBy` set to the primary successor, and describe the rest in `migration`.",
    "resurrect": "A tombstoned ID must never reappear in live seed data — it would silently re-point existing user rows at a new meaning."
  },
  "namespaces": {
    "supplements": {
      "source": "SEED_SUPPLEMENTS[].id",
      "persistedAt": [
        "stack_items.supplement_id (0001, text, no FK)",
        "checkins.taken[] (0006, jsonb array of supplementId)",
        "checkins.scheduled[] (0006, jsonb array of supplementId)",
        "advisor_actions.payload/inverse (0004, jsonb StackItemInput.supplementId)"
      ],
      "dereferenced": true,
